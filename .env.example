# BREAKING NEWS WALA (ब्रेकिंग न्यूज़ वाला)
# Master Environment Configuration Template
# Document Reference: docs/25-Environment.md (Section 20.1)
# Security Policy: Do NOT commit real secrets or production credentials.

# -----------------------------------------------------------------------------
# Core Application & Runtime (DEC-011)
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
APP_MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# Backend API Ingress & Security (DEC-025)
# -----------------------------------------------------------------------------
API_PREFIX=/api/v1
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=1000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
BODY_PARSER_LIMIT=10mb
SERVER_GRACEFUL_SHUTDOWN_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Relational Database - PostgreSQL 16 (DEC-017, DEC-018)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:<LOCAL_DEV_PASSWORD>@localhost:5432/breaking_news_wala_dev?sslmode=disable
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_SSL_MODE=disable
DB_MIGRATION_AUTO_RUN=true

# -----------------------------------------------------------------------------
# In-Memory Cache & Job Queue - Redis 7 & BullMQ (DEC-014, DEC-015)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER_MODE=false
REDIS_KEY_PREFIX=bnw_dev:
BULLMQ_CONCURRENCY=5
BULLMQ_DEFAULT_JOB_ATTEMPTS=2
BULLMQ_BACKOFF_DELAY_MS=2000

# -----------------------------------------------------------------------------
# Dual-Token JWT & Authentication Security (DEC-033, DEC-034)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=<LOCAL_EPHEMERAL_JWT_ACCESS_SECRET_32_BYTES_MIN>
JWT_REFRESH_SECRET=<LOCAL_EPHEMERAL_JWT_REFRESH_SECRET_32_BYTES_MIN>
JWT_ACCESS_EXPIRATION_SEC=900
JWT_REFRESH_EXPIRATION_SEC=604800
ARGON2_MEMORY_COST_KB=65536
ARGON2_TIME_COST=3
SESSION_COOKIE_NAME=bnw_session_dev
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Media Storage & CDN (DEC-016, DEC-020)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=bnw-media-dev
CDN_PUBLIC_BASE_URL=http://localhost:3000/uploads

# -----------------------------------------------------------------------------
# Multi-Provider AI API Pool (DEC-050)
# -----------------------------------------------------------------------------
AI_POOL_ROUTING_STRATEGY=latency-cost-balanced
AI_DEFAULT_FALLBACK_ORDER=gemini,groq,claude
GEMINI_API_KEY=<DEVELOPER_GEMINI_KEY_FROM_AI_STUDIO>
CLAUDE_API_KEY=<OPTIONAL_SANDBOX_CLAUDE_KEY>
GROQ_API_KEY=<OPTIONAL_SANDBOX_GROQ_KEY>
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AI_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# RSS Ingestion & Model Context Protocol (DEC-053)
# -----------------------------------------------------------------------------
RSS_INGESTION_ENABLED=true
RSS_POLL_INTERVAL_SEC=120
RSS_FETCH_TIMEOUT_MS=5000
URL_SSRF_PROTECTION_ENABLED=true
MCP_ENABLED=true

# -----------------------------------------------------------------------------
# Structured Logging & Observability (DEC-072, DEC-073)
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=pretty
METRICS_ENABLED=false

# -----------------------------------------------------------------------------
# Push & Multi-Channel Notifications (DEC-031, docs/25-Environment.md Section 16)
# -----------------------------------------------------------------------------
FCM_ENABLED=false
FCM_PROJECT_ID=<FIREBASE_PROJECT_ID>
FCM_SERVICE_ACCOUNT_KEY=<BASE64_OR_PATH_TO_FCM_SERVICE_ACCOUNT_JSON>
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY_P256>
VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY_SECRET>
VAPID_SUBJECT=mailto:admin@breakingnewswala.com
NOTIF_MAX_HOURLY=3
NOTIF_MAX_DAILY=10
NOTIF_QUIET_HOURS_START=22
NOTIF_QUIET_HOURS_END=6
