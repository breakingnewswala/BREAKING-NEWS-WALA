# BREAKING NEWS WALA (ब्रेकिंग न्यूज़ वाला) - STAGING ENVIRONMENT CONFIGURATION
# Used for live pre-production validation before promoting to main (Production)

# Application Environment Mode
NODE_ENV=staging
APP_ENV=staging
VITE_APP_ENV=staging
APP_BASE_URL=https://breakingnewswala.com/testing
CDN_PUBLIC_BASE_URL=https://breakingnewswala.com/testing
VITE_BASE_PATH=/testing/

# Server & Network Ports
PORT=3000
DEFAULT_APP_PORT=3000
HOST=0.0.0.0

# Database & Persistence (Staging Firestore / Local Persistence)
PERSISTENCE_MODE=firestore
FIREBASE_PROJECT_ID=breaking-news-wala
FIRESTORE_DATABASE_ID=ai-studio-breakingnewswala-81a8a8f4-57a5-4181-aa74-2ef4d34fbab7
FIREBASE_STORAGE_BUCKET=breaking-news-wala.firebasestorage.app

# API Rate Limiting (Relaxed for Staging QA Testing)
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=600

# Logging & Telemetry
LOG_LEVEL=debug
LOG_FORMAT=json

# AI Providers & Model Routing
AI_PROVIDER=gemini
AI_POOL_ROUTING_STRATEGY=adaptive_waterfall
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# Security Tokens & JWT
JWT_ACCESS_EXPIRATION_SEC=900
JWT_REFRESH_EXPIRATION_SEC=604800
ARGON2_MEMORY_COST_KB=65536
ARGON2_TIME_COST=3
