    {
      "id": "page-ep-1795031625317-tsgrn-1",
      "editionId": "ep-1795031625317-tsgrn",
      "pageNumber": 1,
      "pageTitle": "प्रथम पृष्ठ (मुख्य समाचार)",
      "sectionType": "FRONT_PAGE",
      "templateId": "tpl-epaper-01-front",
      "gridColumns": 8,
      "elements": [
        {
          "id": "story-lead-01",
          "elementType": "STORY",
          "headline": "मध्य प्रदेश में नवीकरणीय ऊर्जा विकास योजना का विस्तार",
          "customBodyText": "सौर ऊर्जा संयंत्रों की स्थापना से 500 मेगावॉट अतिरिक्त बिजली उत्पादन का लक्ष्य तय।",
