rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE HARDENED HELPERS ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Bootstrapped Admin: user email from runtime or explicit admin record
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'breakingnewswala.com@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['title', 'content', 'category', 'district', 'status', 'authorId', 'authorName']) &&
        data.title is string && data.title.size() <= 300 &&
        data.content is string && data.content.size() <= 50000 &&
        data.category is string && data.category.size() <= 100 &&
        data.district is string && data.district.size() <= 100 &&
        data.status is string &&
        data.authorId is string && data.authorId.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 150;
    }

    // Connection Healthcheck
    match /test/{testId} {
      allow get: if true;
    }

    // --- NEWS COLLECTION ---
    match /news/{newsId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(newsId);
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.authorId == request.auth.uid);
    }

    // --- ARTICLES COLLECTION ---
    match /articles/{articleId} {
      // Public can only view published articles; authors and admins can inspect pending/drafts
      allow get: if resource.data.status == 'published' || 
                    (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()));
      
      allow list: if resource.data.status == 'published' || 
                     (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()));

      allow create: if isSignedIn() && 
                       isValidId(articleId) && 
                       isValidArticle(incoming()) && 
                       (incoming().authorId == request.auth.uid || isAdmin());

      allow update: if isSignedIn() && 
                       isValidId(articleId) && 
                       isValidArticle(incoming()) &&
                       (
                         isAdmin() || 
                         (
                           existing().authorId == request.auth.uid &&
                           incoming().authorId == existing().authorId &&
                           (existing().status != 'published' || isAdmin())
                         )
                       );

      allow delete: if isAdmin();
    }

    // --- CATEGORIES COLLECTION ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- LIVE TICKERS COLLECTION ---
    match /tickers/{tickerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- USER PROFILE & SAVED BOOKMARKS ---
    match /users/{userId} {
      allow read, write: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // --- ADMIN AUTHORIZATION ROSTER ---
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
