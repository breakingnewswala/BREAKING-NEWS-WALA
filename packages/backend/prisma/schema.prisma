  idempotencyKey        String    @unique @map("idempotency_key") @db.VarChar(100)
  approvedByUserId      String?   @map("approved_by_user_id") @db.Uuid
  approvedAt            DateTime? @map("approved_at") @db.Timestamptz(6)
  createdByUserId       String    @map("created_by_user_id") @db.Uuid
  totalDeliveries       Int       @default(0) @map("total_deliveries")
  successfulDeliveries  Int       @default(0) @map("successful_deliveries")
  failedDeliveries      Int       @default(0) @map("failed_deliveries")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  deliveries            SocialPublishingDelivery[]

  @@map("social_publishing_jobs")
}

model SocialPublishingDelivery {
  id                      String              @id @default(uuid()) @db.Uuid
  jobId                   String              @map("job_id") @db.Uuid
  socialAccountId         String              @map("social_account_id") @db.Uuid
  platform                String              @db.VarChar(50)
  platformSpecificContent String              @map("platform_specific_content") @db.Text
  status                  String              @default("PENDING") @db.VarChar(50)
  externalPostId          String?             @map("external_post_id") @db.VarChar(150)
  externalPostUrl         String?             @map("external_post_url") @db.VarChar(500)
  attemptCount            Int                 @default(0) @map("attempt_count")
  maxAttempts             Int                 @default(3) @map("max_attempts")
  nextRetryAt             DateTime?           @map("next_retry_at") @db.Timestamptz(6)
  lastAttemptAt           DateTime?           @map("last_attempt_at") @db.Timestamptz(6)
  errorCode               String?             @map("error_code") @db.VarChar(100)
  errorMessage            String?             @map("error_message") @db.Text
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  job                     SocialPublishingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  socialAccount           SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("social_publishing_deliveries")
}

model ProviderWebhookEvent {
  id           String    @id @default(uuid()) @db.Uuid
  providerId   String    @map("provider_id") @db.VarChar(50)
  eventType    String    @map("event_type") @db.VarChar(100)
  deliveryId   String?   @map("delivery_id") @db.VarChar(150)
  nonce        String?   @db.VarChar(100)
  signature    String?   @db.VarChar(255)
  status       String    @default("received") @db.VarChar(50)
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(6)
  errorDetails String?   @map("error_details") @db.Text

  @@index([providerId, eventType])
  @@map("provider_webhook_events")
}

// ============================================================================
// DOM-S: SEO Metadata & Search Console Integration (BNW-MASTER-008)
// ============================================================================

model ArticleSeoMetadata {
  id                  String      @id @default(uuid()) @db.Uuid
  articleId           String      @unique @map("article_id") @db.Uuid
  seoTitle            String?     @map("seo_title") @db.VarChar(200)
  metaDescription     String?     @map("meta_description") @db.VarChar(320)
  canonicalUrl        String?     @map("canonical_url") @db.Text
  focusKeywords       String[]    @default([]) @map("focus_keywords")
  ogTitle             String?     @map("og_title") @db.VarChar(200)
  ogDescription       String?     @map("og_description") @db.VarChar(320)
  ogImageUrl          String?     @map("og_image_url") @db.Text
  twitterCardType     String      @default("summary_large_image") @map("twitter_card_type") @db.VarChar(50)
  robotsDirectives    String      @default("index, follow") @map("robots_directives") @db.VarChar(100)
  structuredDataType  String      @default("NewsArticle") @map("structured_data_type") @db.VarChar(50)
  isIndexed           Boolean     @default(false) @map("is_indexed")
  searchConsoleStatus String      @default("pending_configuration") @map("search_console_status") @db.VarChar(50)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  article             NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_seo_metadata")
}

model SearchConsoleIntegration {
  id                   String    @id @default(uuid()) @db.Uuid
  siteUrl              String    @map("site_url") @db.VarChar(255)
  propertyType         String    @default("URL_PREFIX") @map("property_type") @db.VarChar(50)
  connectionStatus     String    @default("pending_configuration") @map("connection_status") @db.VarChar(50)
  serviceAccountEmail  String?   @map("service_account_email") @db.VarChar(255)
  lastSyncAt           DateTime? @map("last_sync_at") @db.Timestamptz(6)
  verifiedOwnership    Boolean   @default(false) @map("verified_ownership")
  configuration        Json?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("search_console_integrations")
}

// ============================================================================
// DOM-T: E-Paper Management System (Digital Replica & Editions) (BNW-MASTER-008)
// ============================================================================

model EpaperEdition {
  id             String       @id @default(uuid()) @db.Uuid
  editionCode    String       @unique @map("edition_code") @db.VarChar(50)
  title          String       @db.VarChar(200)
  editionDate    DateTime     @map("edition_date") @db.Date
  editionType    String       @default("DAILY") @map("edition_type") @db.VarChar(50)
  language       String       @default("hi") @db.VarChar(10)
  districtId     String?      @map("district_id") @db.VarChar(100)
  status         String       @default("DRAFT") @db.VarChar(50)
  pageCount      Int          @default(0) @map("page_count")
  coverImageUrl  String?      @map("cover_image_url") @db.Text
  pdfAssetUrl    String?      @map("pdf_asset_url") @db.Text
  pdfFileSize    BigInt       @default(0) @map("pdf_file_size")
  pdfSha256      String?      @map("pdf_sha256") @db.VarChar(64)
  scheduledAt    DateTime?    @map("scheduled_at") @db.Timestamptz(6)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  createdBy      String       @map("created_by") @db.Uuid
  approvedBy     String?      @map("approved_by") @db.Uuid
  isPublic       Boolean      @default(true) @map("is_public")
  isArchived     Boolean      @default(false) @map("is_archived")
  viewCount      BigInt       @default(0) @map("view_count")
  downloadCount  BigInt       @default(0) @map("download_count")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  pages          EpaperPage[]

  @@index([editionDate, districtId])
  @@index([status, editionDate])
  @@map("epaper_editions")
}

model EpaperPage {
  id                String        @id @default(uuid()) @db.Uuid
  editionId         String        @map("edition_id") @db.Uuid
  pageNumber        Int           @map("page_number")
  pageTitle         String?       @map("page_title") @db.VarChar(150)
  imageUrl          String        @map("image_url") @db.Text
  thumbnailImageUrl String?       @map("thumbnail_image_url") @db.Text
  width             Int           @default(1240)
  height            Int           @default(1754)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  edition           EpaperEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, pageNumber])
  @@map("epaper_pages")
}
