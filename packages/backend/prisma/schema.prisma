// BREAKING NEWS WALA (ब्रेकिंग न्यूज़ वाला)
// Canonical Prisma ORM Schema Specification
// Grounded strictly in docs/12-Database.md (Domain Schemas DOM-A to DOM-P)
// Authoritative Decision: DEC-017 (PostgreSQL 16+), DEC-018 (Prisma ORM v5+)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// DOM-A: User & Identity Management
// ============================================================================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  phoneNumber     String?   @unique @map("phone_number") @db.VarChar(20)
  email           String?   @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  status          String    @default("active") @db.VarChar(30)
  phoneVerified   Boolean   @default(false) @map("phone_verified")
  emailVerified   Boolean   @default(false) @map("email_verified")
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  mfaSecret       String?   @map("mfa_secret") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  profile                     UserProfile?
  reporterProfile             ReporterProfile?
  userRoles                   UserRole[]
  assignedRoles               UserRole[]                     @relation("AssignedByUser")
  authSessions                AuthSession[]
  deviceRegistrations         DeviceRegistration[]
  authoredArticles            NewsArticle[]                  @relation("ArticleAuthor")
  editedArticles              NewsArticle[]                  @relation("ArticleLastEditor")
  newsRevisions               NewsRevision[]
  editorialReviews            EditorialReview[]
  uploadedMedia               MediaAsset[]
  assignedReporterTemplates   ReporterTemplateAssignment[]
  createdGraphics             GeneratedGraphic[]
  createdVideoProjects        VideoProject[]
  bookmarks                   UserBookmark[]
  readingHistory              UserReadingHistory[]
  articleFeedback             UserArticleFeedback[]
  receivedNotifications       Notification[]
  coinWallet                  CoinWallet?
  referredCoinWallets         CoinWallet[]                   @relation("ReferredByUser")
  auditLogs                   AuditLog[]
  updatedSystemSettings       SystemSetting[]
  modifiedFeatureFlags        FeatureFlag[]
  assignedTerritories         ReporterTerritoryAssignment[]  @relation("TerritoryAssignedBy")
  audiencePreference          AudiencePreference?

  @@map("users")
}

model UserProfile {
  userId            String       @id @map("user_id") @db.Uuid
  fullName          String       @map("full_name") @db.VarChar(150)
  avatarMediaId     String?      @map("avatar_media_id") @db.Uuid
  bio               String?      @db.Text
  preferredLanguage String       @default("hi") @map("preferred_language") @db.VarChar(10)
  homeStateId       String?      @map("home_state_id") @db.Uuid
  homeDistrictId    String?      @map("home_district_id") @db.Uuid

  // Relations
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeState         GeoLocation? @relation("ProfileHomeState", fields: [homeStateId], references: [id], onDelete: SetNull)
  homeDistrict      GeoLocation? @relation("ProfileHomeDistrict", fields: [homeDistrictId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(50)
  displayName String           @map("display_name") @db.VarChar(100)
  isSystem    Boolean          @default(true) @map("is_system")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  module      String           @db.VarChar(50)
  description String?          @db.Text

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner   User?    @relation("AssignedByUser", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  // Relations
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  clientType       String?   @map("client_type") @db.VarChar(50)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model DeviceRegistration {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  platform     String   @db.VarChar(20) // web, android, ios
  pushToken    String   @unique @map("push_token") @db.Text
  lastActiveAt DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)

  // Relations
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_registrations")
}

// ============================================================================
// DOM-B: Reporter Management & Territory Allocation
// ============================================================================

model ReporterProfile {
  userId              String    @id @map("user_id") @db.Uuid
  reporterCode        String    @unique @map("reporter_code") @db.VarChar(30)
  pressIdCardNumber   String?   @map("press_id_card_number") @db.VarChar(50)
  idCardMediaId       String?   @map("id_card_media_id") @db.Uuid
  verificationStatus  String    @default("pending") @map("verification_status") @db.VarChar(30)
  isTrustedReporter   Boolean   @default(false) @map("is_trusted_reporter")
  canDirectPublish    Boolean   @default(false) @map("can_direct_publish")
  trustScore          Int       @default(50) @map("trust_score")
  totalSubmissions    Int       @default(0) @map("total_submissions")
  approvedSubmissions Int       @default(0) @map("approved_submissions")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(6)

  // Relations
  user                User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  territoryAssignments ReporterTerritoryAssignment[]
  templateAssignments  ReporterTemplateAssignment[]

  @@map("reporter_profiles")
}

model ReporterTerritoryAssignment {
  id             String      @id @default(uuid()) @db.Uuid
  reporterId     String      @map("reporter_id") @db.Uuid
  locationId     String      @map("location_id") @db.Uuid
  assignmentType String      @default("BEAT") @map("assignment_type") @db.VarChar(30) // PRIMARY, SECONDARY, BEAT
  assignedBy     String?     @map("assigned_by") @db.Uuid
  assignedAt     DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(6)
  status         String      @default("active") @db.VarChar(30)

  // Relations
  reporter       ReporterProfile @relation(fields: [reporterId], references: [userId], onDelete: Cascade)
  location       GeoLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  assigner       User?           @relation("TerritoryAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@map("reporter_territory_assignments")
}

// ============================================================================
// DOM-C: Geographical Data & Territories
// ============================================================================

model GeoLocation {
  id           String        @id @default(uuid()) @db.Uuid
  nameHi       String        @map("name_hi") @db.VarChar(100)
  nameEn       String        @map("name_en") @db.VarChar(100)
  slug         String        @unique @db.VarChar(120)
  level        String        @db.VarChar(30) // country, state, division, district, city, tehsil
  parentId     String?       @map("parent_id") @db.Uuid
  stateCode    String?       @map("state_code") @db.VarChar(10)
  latitude     Decimal?      @db.Decimal(10, 8)
  longitude    Decimal?      @db.Decimal(11, 8)
  displayOrder Int           @default(0) @map("display_order")
  isActive     Boolean       @default(true) @map("is_active")

  // Relations
  parent              GeoLocation?                   @relation("GeoHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            GeoLocation[]                  @relation("GeoHierarchy")
  articles            NewsArticle[]                  @relation("ArticleLocation")
  userProfilesState   UserProfile[]                  @relation("ProfileHomeState")
  userProfilesDistrict UserProfile[]                 @relation("ProfileHomeDistrict")
  reporterAssignments ReporterTerritoryAssignment[]
  adCreativesTargeted AdCreative[]

  @@map("geo_locations")
}

// ============================================================================
// DOM-D: News & Editorial Lifecycle Management
// ============================================================================

model NewsArticle {
  id                 String    @id @default(uuid()) @db.Uuid
  publicId           String    @unique @map("public_id") @db.VarChar(30)
  slug               String    @unique @db.VarChar(255)
  title              String    @db.Text
  subheadline        String?   @db.Text
  bodyContent        String    @map("body_content") @db.Text
  excerpt            String?   @db.Text
  authorId           String    @map("author_id") @db.Uuid
  lastEditorId       String?   @map("last_editor_id") @db.Uuid
  primaryCategoryId  String    @map("primary_category_id") @db.Uuid
  primaryLocationId  String    @map("primary_location_id") @db.Uuid
  featuredMediaId    String?   @map("featured_media_id") @db.Uuid
  status             String    @default("draft") @db.VarChar(30)
  contentSource      String    @default("original_reporter") @map("content_source") @db.VarChar(30)
  sourceAttribution  String?   @map("source_attribution") @db.VarChar(255)
  isBreaking         Boolean   @default(false) @map("is_breaking")
  breakingPriority   Int       @default(0) @map("breaking_priority")
  viewCount          BigInt    @default(0) @map("view_count")
  shareCount         Int       @default(0) @map("share_count")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedAt        DateTime? @map("submitted_at") @db.Timestamptz(6)
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6)
  scheduledAt        DateTime? @map("scheduled_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  author             User                      @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  lastEditor         User?                     @relation("ArticleLastEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  primaryCategory    Category                  @relation(fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  primaryLocation    GeoLocation               @relation("ArticleLocation", fields: [primaryLocationId], references: [id], onDelete: Restrict)
  featuredMedia      MediaAsset?               @relation("ArticleFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  revisions          NewsRevision[]
  editorialReviews   EditorialReview[]
  importedRssItem    ImportedRssItem?
  generatedGraphics  GeneratedGraphic[]
  userBookmarks      UserBookmark[]
  readingHistory     UserReadingHistory[]
  articleFeedback    UserArticleFeedback[]
  dailyAnalytics     DailyArticleAnalytics[]
  seoMetadata        ArticleSeoMetadata?
  trendingExclusions TrendingExclusion[]

  @@index([primaryLocationId, publishedAt])
  @@index([primaryCategoryId, publishedAt])
  @@index([status, publishedAt])
  @@map("news_articles")
}

model NewsRevision {
  id              String      @id @default(uuid()) @db.Uuid
  newsId          String      @map("news_id") @db.Uuid
  versionNumber   Int         @map("version_number")
  title           String      @db.Text
  bodyContent     String      @map("body_content") @db.Text
  subheadline     String?     @db.Text
  excerpt         String?     @db.Text
  revisedBy       String      @map("revised_by") @db.Uuid
  revisionSummary String?     @map("revision_summary") @db.VarChar(255)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  article         NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)
  reviser         User        @relation(fields: [revisedBy], references: [id], onDelete: Restrict)

  @@unique([newsId, versionNumber])
  @@map("news_revisions")
}

model EditorialReview {
  id               String      @id @default(uuid()) @db.Uuid
  newsId           String      @map("news_id") @db.Uuid
  reviewerId       String      @map("reviewer_id") @db.Uuid
  action           String      @db.VarChar(30) // approved, rejected, changes_requested, direct_published, retracted
  reasonCode       String?     @map("reason_code") @db.VarChar(50)
  feedbackComments String?     @map("feedback_comments") @db.Text
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  article          NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)
  reviewer         User        @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@map("editorial_reviews")
}

// ============================================================================
// DOM-E: Categories & Subcategories
// ============================================================================

model Category {
  id           String      @id @default(uuid()) @db.Uuid
  nameHi       String      @map("name_hi") @db.VarChar(100)
  nameEn       String      @map("name_en") @db.VarChar(100)
  slug         String      @unique @db.VarChar(120)
  description  String?     @db.Text
  iconMediaId  String?     @map("icon_media_id") @db.Uuid
  parentId     String?     @map("parent_id") @db.Uuid
  displayOrder Int         @default(0) @map("display_order")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)

  // Relations
  parent            Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          Category[]        @relation("CategoryHierarchy")
  articles          NewsArticle[]
  rssSources        RssSource[]
  graphicTemplates  GraphicTemplate[]

  @@map("categories")
}

// ============================================================================
// DOM-F: RSS & URL Ingestion
// ============================================================================

model RssSource {
  id                     String    @id @default(uuid()) @db.Uuid
  name                   String    @db.VarChar(150)
  feedUrl                String    @unique @map("feed_url") @db.Text
  isAuthorized           Boolean   @default(true) @map("is_authorized")
  pollingIntervalMinutes Int       @default(30) @map("polling_interval_minutes")
  defaultCategoryId      String?   @map("default_category_id") @db.Uuid
  status                 String    @default("active") @db.VarChar(30)

  // Relations
  defaultCategory        Category?         @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  importedItems          ImportedRssItem[]

  @@map("rss_sources")
}

model ImportedRssItem {
  id                 String       @id @default(uuid()) @db.Uuid
  rssSourceId        String       @map("rss_source_id") @db.Uuid
  guidHash           String       @unique @map("guid_hash") @db.VarChar(64)
  originalTitle      String       @map("original_title") @db.Text
  originalUrl        String       @map("original_url") @db.Text
  generatedNewsId    String?      @unique @map("generated_news_id") @db.Uuid
  aiProcessingStatus String       @default("pending") @map("ai_processing_status") @db.VarChar(30)
  importedAt         DateTime     @default(now()) @map("imported_at") @db.Timestamptz(6)

  // Relations
  rssSource          RssSource    @relation(fields: [rssSourceId], references: [id], onDelete: Cascade)
  generatedNews      NewsArticle? @relation(fields: [generatedNewsId], references: [id], onDelete: SetNull)

  @@map("imported_rss_items")
}

// ============================================================================
// DOM-G: AI Processing & API Pool Management
// ============================================================================

model AiProvider {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique @db.VarChar(50) // gemini, claude, openai, groq, deepseek
  isActive Boolean   @default(true) @map("is_active")

  // Relations
  models   AiModel[]
  apiKeys  AiApiKeyReference[]

  @@map("ai_providers")
}

model AiModel {
  id                  String     @id @default(uuid()) @db.Uuid
  providerId          String     @map("provider_id") @db.Uuid
  modelIdentifier     String     @map("model_identifier") @db.VarChar(100)
  contextWindowTokens Int        @map("context_window_tokens")
  isDefault           Boolean    @default(false) @map("is_default")

  // Relations
  provider            AiProvider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  processingRequests  AiProcessingRequest[]

  @@map("ai_models")
}

model AiApiKeyReference {
  id                 String     @id @default(uuid()) @db.Uuid
  providerId         String     @map("provider_id") @db.Uuid
  keyAlias           String     @map("key_alias") @db.VarChar(100)
  vaultSecretPath    String     @map("vault_secret_path") @db.VarChar(255)
  quotaLimitQpm      Int        @default(60) @map("quota_limit_qpm")
  currentStatus      String     @default("healthy") @map("current_status") @db.VarChar(30)

  // Relations
  provider           AiProvider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  processingRequests AiProcessingRequest[]

  @@map("ai_api_key_references")
}

model AiProcessingRequest {
  id                  String             @id @default(uuid()) @db.Uuid
  modelId             String?            @map("model_id") @db.Uuid
  keyReferenceId      String?            @map("key_reference_id") @db.Uuid
  taskType            String             @map("task_type") @db.VarChar(50)
  promptTokens        Int                @default(0) @map("prompt_tokens")
  completionTokens    Int                @default(0) @map("completion_tokens")
  executionDurationMs Int                @default(0) @map("execution_duration_ms")
  status              String             @db.VarChar(30)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  model               AiModel?           @relation(fields: [modelId], references: [id], onDelete: SetNull)
  keyReference        AiApiKeyReference? @relation(fields: [keyReferenceId], references: [id], onDelete: SetNull)

  @@map("ai_processing_requests")
}

// ============================================================================
// DOM-H: Graphics Studio
// ============================================================================

model GraphicTemplate {
  id                    String      @id @default(uuid()) @db.Uuid
  name                  String      @db.VarChar(150)
  aspectRatio           String      @default("16:9") @map("aspect_ratio") @db.VarChar(20)
  templateSchemaJson    Json        @map("template_schema_json")
  categoryRestrictionId String?     @map("category_restriction_id") @db.Uuid
  isActive              Boolean     @default(true) @map("is_active")

  // Relations
  categoryRestriction   Category?                    @relation(fields: [categoryRestrictionId], references: [id], onDelete: SetNull)
  templateAssignments   ReporterTemplateAssignment[]
  generatedGraphics     GeneratedGraphic[]

  @@map("graphic_templates")
}

model ReporterTemplateAssignment {
  reporterId String          @map("reporter_id") @db.Uuid
  templateId String          @map("template_id") @db.Uuid
  assignedBy String?         @map("assigned_by") @db.Uuid
  assignedAt DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(6)

  // Relations
  reporter   ReporterProfile @relation(fields: [reporterId], references: [userId], onDelete: Cascade)
  template   GraphicTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assigner   User?           @relation(fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([reporterId, templateId])
  @@map("reporter_template_assignments")
}

model GeneratedGraphic {
  id               String          @id @default(uuid()) @db.Uuid
  templateId       String          @map("template_id") @db.Uuid
  creatorId        String          @map("creator_id") @db.Uuid
  associatedNewsId String?         @map("associated_news_id") @db.Uuid
  rawInputText     String?         @map("raw_input_text") @db.Text
  outputMediaId    String?         @map("output_media_id") @db.Uuid
  renderStatus     String          @default("completed") @map("render_status") @db.VarChar(30)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  template         GraphicTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  creator          User            @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  associatedNews   NewsArticle?    @relation(fields: [associatedNewsId], references: [id], onDelete: SetNull)
  outputMedia      MediaAsset?     @relation(fields: [outputMediaId], references: [id], onDelete: SetNull)

  @@map("generated_graphics")
}

// ============================================================================
// DOM-I: Video Studio
// ============================================================================

model VideoProject {
  id                String            @id @default(uuid()) @db.Uuid
  title             String            @db.VarChar(200)
  aspectRatio       String            @default("9:16") @map("aspect_ratio") @db.VarChar(20)
  scriptText        String            @map("script_text") @db.Text
  voiceoverMediaId  String?           @map("voiceover_media_id") @db.Uuid
  status            String            @default("draft") @db.VarChar(30)
  creatorId         String            @map("creator_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  creator           User              @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  voiceoverMedia    MediaAsset?       @relation(fields: [voiceoverMediaId], references: [id], onDelete: SetNull)
  renderJobs        VideoRenderJob[]

  @@map("video_projects")
}

model VideoRenderJob {
  id                    String       @id @default(uuid()) @db.Uuid
  projectId             String       @map("project_id") @db.Uuid
  renderProgressPercent Int          @default(0) @map("render_progress_percent")
  outputMediaId         String?      @map("output_media_id") @db.Uuid
  status                String       @default("queued") @db.VarChar(30)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  project               VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outputMedia           MediaAsset?  @relation(fields: [outputMediaId], references: [id], onDelete: SetNull)

  @@map("video_render_jobs")
}

// ============================================================================
// DOM-J: Media Asset Management
// ============================================================================

model MediaAsset {
  id             String         @id @default(uuid()) @db.Uuid
  storageKey     String         @unique @map("storage_key") @db.VarChar(255)
  cdnUrl         String         @map("cdn_url") @db.Text
  fileType       String         @map("file_type") @db.VarChar(30) // image, video, audio, document
  mimeType       String         @map("mime_type") @db.VarChar(100)
  fileSizeBytes  BigInt         @map("file_size_bytes")
  width          Int?
  height         Int?
  aspectRatio    String?        @map("aspect_ratio") @db.VarChar(20)
  blurhash       String?        @db.VarChar(100)
  altTextHi      String?        @map("alt_text_hi") @db.Text
  uploadedBy     String?        @map("uploaded_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  uploader           User?              @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  variants           MediaVariant[]
  featuredInArticles NewsArticle[]      @relation("ArticleFeaturedMedia")
  generatedGraphics  GeneratedGraphic[]
  videoProjectsVoice VideoProject[]
  videoRenderOutputs VideoRenderJob[]
  adCreatives        AdCreative[]

  @@map("media_assets")
}

model MediaVariant {
  id            String     @id @default(uuid()) @db.Uuid
  parentMediaId String     @map("parent_media_id") @db.Uuid
  variantType   String     @map("variant_type") @db.VarChar(30) // thumbnail, mobile, tablet, 16x9, 1x1, 9x16
  storageKey    String     @map("storage_key") @db.VarChar(255)
  cdnUrl        String     @map("cdn_url") @db.Text
  width         Int?
  height        Int?

