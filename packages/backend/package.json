{
  "name": "@bnw/backend",
  "version": "1.0.0",
  "private": true,
  "description": "BREAKING NEWS WALA — Shared Central Modular Monolith API Engine",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "check:env": "tsx scripts/check-environment.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@bnw/tokens": "*",
    "@bnw/types": "*",
    "@prisma/client": "^5.22.0",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
