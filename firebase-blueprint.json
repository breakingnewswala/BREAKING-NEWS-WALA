{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile with role-based access control for Breaking News Wala",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching document ID"
        },
        "email": {
          "type": "string",
          "description": "Verified user email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full display name"
        },
        "photoUrl": {
          "type": "string",
          "description": "Profile avatar photo URL (optional)"
        },
        "role": {
          "type": "string",
          "enum": ["READER", "REPORTER", "ADMIN"],
          "description": "Access role in the platform"
        },
        "district": {
          "type": "string",
          "description": "Preferred or assigned district"
        },
        "coins": {
          "type": "integer",
          "description": "Reward coins balance"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp; clients must submit FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp; clients must submit FieldValue.serverTimestamp()"
        }
      },
      "required": ["uid", "email", "displayName", "role", "coins", "createdAt", "updatedAt"]
    },
    "BookmarkItem": {
      "title": "BookmarkItem",
      "description": "Saved article bookmark scoped to a specific user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "articleId": {
          "type": "string",
          "description": "Saved article ID"
        },
        "articleTitle": {
          "type": "string",
          "description": "Saved article headline"
        },
        "articleCategory": {
          "type": "string",
          "description": "Saved article category"
        },
        "articleDistrict": {
          "type": "string",
          "description": "Saved article district"
        },
        "articleImageUrl": {
          "type": "string",
          "description": "Saved article image URL (optional)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp; clients must submit FieldValue.serverTimestamp()"
        }
      },
      "required": ["userId", "articleId", "articleTitle", "createdAt"]
    },
    "NewsArticle": {
      "title": "NewsArticle",
      "description": "Hyperlocal & National news article or reporter submission",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Hindi / Devanagari headline"
        },
        "summary": {
          "type": "string",
          "description": "Short lead summary"
        },
        "content": {
          "type": "string",
          "description": "Full article body"
        },
        "category": {
          "type": "string",
          "description": "News category"
        },
        "district": {
          "type": "string",
          "description": "Target district or national hub"
        },
        "state": {
          "type": "string",
          "description": "State or National scope"
        },
        "authorId": {
          "type": "string",
          "description": "UID of author"
        },
        "authorName": {
          "type": "string",
          "description": "Author display name"
        },
        "authorRole": {
          "type": "string",
          "enum": ["REPORTER", "ADMIN"],
          "description": "Author role at submission time"
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "PENDING_VERIFICATION", "PUBLISHED", "REJECTED"],
          "description": "Editorial workflow state"
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional banner image URL"
        },
        "breaking": {
          "type": "boolean",
          "description": "Breaking news ticker flag"
        },
        "live": {
          "type": "boolean",
          "description": "Live updating coverage flag"
        },
        "viewCount": {
          "type": "integer",
          "description": "Impression counter"
        },
        "editorialNote": {
          "type": "string",
          "description": "Moderator / editor fact-check note (optional)"
        },
        "aiScore": {
          "type": "integer",
          "description": "Gemini AI 10-point editorial readiness score (optional)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp; clients must submit FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp; clients must submit FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "title",
        "summary",
        "content",
        "category",
        "district",
        "state",
        "authorId",
        "authorName",
        "authorRole",
        "status",
        "breaking",
        "live",
        "viewCount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile records with strict owner + admin isolation"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/BookmarkItem" },
      "description": "User-scoped saved article bookmarks"
    },
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/NewsArticle" },
      "description": "News articles and reporter submissions"
    }
  }
}
