{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "Published and pending news articles in BREAKING NEWS WALA",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 50000 },
        "rawScript": { "type": "string", "maxLength": 10000 },
        "slug": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 100 },
        "subcategory": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "city": { "type": "string", "maxLength": 100 },
        "thumbnail": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["draft", "pending_review", "revision_requested", "approved", "published", "rejected", "archived"] },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 150 },
        "authorRole": { "type": "string", "enum": ["reporter", "trusted_reporter", "admin", "editor"] },
        "isTrustedPublish": { "type": "boolean" },
        "isBreaking": { "type": "boolean" },
        "isLeadStory": { "type": "boolean" },
        "views": { "type": "number" },
        "shares": { "type": "number" },
        "bookmarks": { "type": "number" },
        "readingTimeMinutes": { "type": "number" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "publishedAt": { "type": "string" }
      },
      "required": ["title", "content", "category", "district", "status", "authorId", "authorName", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Editorial category definition",
      "type": "object",
      "properties": {
        "nameHindi": { "type": "string", "maxLength": 100 },
        "nameEnglish": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "subcategories": { "type": "array" }
      },
      "required": ["nameHindi", "nameEnglish", "slug", "isActive", "order"]
    },
    "BreakingTicker": {
      "title": "BreakingTicker",
      "description": "Live breaking headline message",
      "type": "object",
      "properties": {
        "textHindi": { "type": "string", "maxLength": 500 },
        "priority": { "type": "string", "enum": ["normal", "critical"] },
        "isActive": { "type": "boolean" },
        "articleId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["textHindi", "priority", "isActive", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public user profile and reading ledger",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "savedArticleIds": { "type": "array" },
        "coinsCount": { "type": "number" },
        "preferredDistrict": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized platform administrators",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_admin", "editor"] }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/news/{newsId}": {
      "schema": "Article",
      "description": "Collection of all news articles in BREAKING NEWS WALA"
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Collection of all news articles published and under review"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Active news categories and subcategories"
    },
    "/tickers/{tickerId}": {
      "schema": "BreakingTicker",
      "description": "Active live breaking news ticker messages"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual user preferences, saved bookmarks, and coins"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Admin authorization documents"
    }
  }
}
